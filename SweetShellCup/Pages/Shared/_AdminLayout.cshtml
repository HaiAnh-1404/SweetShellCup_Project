<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SSC Admin Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Work Sans', sans-serif; background: #faf5f8; color: #333; display: flex; min-height: 100vh; }

        /* ===== SIDEBAR ===== */
        .admin-sidebar {
            width: 280px;
            background: #fff;
            border-right: 1px solid #f2e4ec;
            display: flex;
            flex-direction: column;
            padding: 30px 20px;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            margin-bottom: 35px;
            padding-left: 10px;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #e60380, #fd84b2);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .brand-text {
            font-size: 18px;
            font-weight: 800;
            background: linear-gradient(135deg, #e60380, #fd84b2);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .admin-profile-card {
            background: #fff0f6;
            border-radius: 16px;
            padding: 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 30px;
            border: 1px solid #ffe3f0;
        }

        .profile-avatar {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: linear-gradient(135deg, #fd84b2, #e60380);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: #fff;
            font-size: 18px;
        }

        .profile-info {
            overflow: hidden;
        }

        .profile-name {
            font-size: 14px;
            font-weight: 700;
            color: #533931;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .profile-role {
            font-size: 11px;
            font-weight: 600;
            color: #e60380;
            text-transform: uppercase;
        }

        .sidebar-menu {
            display: flex;
            flex-direction: column;
            gap: 8px;
            list-style: none;
        }

        .menu-label {
            font-size: 11px;
            font-weight: 700;
            color: #a08c95;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-top: 15px;
            margin-bottom: 8px;
            padding-left: 10px;
        }

        .menu-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 12px;
            color: #533931;
            font-weight: 600;
            text-decoration: none;
            font-size: 15px;
            transition: all 0.2s ease;
        }

        .menu-link:hover {
            background: #fff0f7;
            color: #e60380;
        }

        .menu-link.active {
            color: #fff;
            background: linear-gradient(135deg, #e60380, #fd84b2);
            box-shadow: 0 4px 12px rgba(230,3,128,0.25);
        }

        .menu-badge {
            background: #ef4444;
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 10px;
            margin-left: auto;
        }

        /* ===== MAIN WRAPPER ===== */
        .admin-wrapper {
            margin-left: 280px;
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ===== HEADER ===== */
        .admin-header {
            height: 80px;
            background: #fff;
            border-bottom: 1px solid #f2e4ec;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            position: sticky;
            top: 0;
            z-index: 90;
        }

        .header-title {
            font-size: 22px;
            font-weight: 800;
            color: #533931;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .datetime-display {
            font-size: 13px;
            color: #a08c95;
            font-weight: 500;
        }

        .btn-logout {
            background: transparent;
            color: #e60380;
            border: 2px solid #fd84b2;
            padding: 8px 18px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s;
        }

        .btn-logout:hover {
            background: #fff0f7;
        }

        /* ===== CONTENT BODY ===== */
        .admin-content {
            padding: 40px;
            flex: 1;
        }

        /* Reusable buttons styles for admin pages in this layout */
        .btn-pink {
            background: linear-gradient(135deg, #e60380, #fd84b2);
            color: #fff !important; border: none;
            padding: 10px 20px; border-radius: 10px;
            font-family: 'Work Sans', sans-serif;
            font-size: 14px; font-weight: 600;
            cursor: pointer; text-decoration: none;
            display: inline-flex; align-items: center; gap: 8px;
            transition: all 0.2s; box-shadow: 0 4px 12px rgba(230,3,128,0.25);
        }
        .btn-pink:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(230,3,128,0.35); }
        .btn-outline-pink {
            background: transparent;
            color: #e60380 !important; border: 2px solid #fd84b2;
            padding: 8px 16px; border-radius: 10px;
            font-family: 'Work Sans', sans-serif;
            font-size: 13px; font-weight: 600;
            cursor: pointer; text-decoration: none;
            display: inline-flex; align-items: center; gap: 8px;
            transition: all 0.2s;
        }
        .btn-outline-pink:hover { background: #fff0f7; }

        @@media (max-width: 992px) {
            .admin-sidebar { width: 80px; padding: 20px 10px; align-items: center; }
            .brand-text, .profile-info, .menu-text, .menu-badge, .menu-label, .admin-profile-card { display: none; }
            .sidebar-brand { justify-content: center; margin-bottom: 20px; padding-left: 0; }
            .admin-wrapper { margin-left: 80px; }
            .menu-link { padding: 12px; justify-content: center; border-radius: 50%; }
        }
    </style>
</head>
<body>

    <!-- SIDEBAR -->
    <aside class="admin-sidebar">
        <a class="sidebar-brand" asp-page="/Admin/Index">
            <div class="brand-icon">🍦</div>
            <span class="brand-text">SSC Admin</span>
        </a>

        @if (User?.Identity?.IsAuthenticated == true)
        {
            <div class="admin-profile-card">
                <div class="profile-avatar">
                    @User.Identity.Name?.Substring(0, Math.Min(2, User.Identity.Name.Length)).ToUpper()
                </div>
                <div class="profile-info">
                    <div class="profile-name">@User.Identity.Name</div>
                    <div class="profile-role">Quản trị viên</div>
                </div>
            </div>
        }

        <ul class="sidebar-menu">
            <span class="menu-label">Hệ thống</span>
            <li>
                <a asp-page="/Admin/Index" class="menu-link @(Context.Request.Path.Value == "/Admin" || Context.Request.Path.Value == "/Admin/" || Context.Request.Path.Value == "/Admin/Index" ? "active" : "")">
                    <span class="menu-icon">📊</span>
                    <span class="menu-text">Dashboard</span>
                </a>
            </li>
            
            <span class="menu-label">Quản lý</span>
            <li>
                <a asp-page="/Admin/Users/Index" class="menu-link @(Context.Request.Path.Value?.Contains("/Admin/Users") == true ? "active" : "")">
                    <span class="menu-icon">👥</span>
                    <span class="menu-text">QL Tài khoản</span>
                </a>
            </li>
            <li>
                <a asp-page="/Admin/Products/Index" class="menu-link @(Context.Request.Path.Value?.Contains("/Admin/Products") == true ? "active" : "")">
                    <span class="menu-icon">📦</span>
                    <span class="menu-text">QL Sản phẩm</span>
                </a>
            </li>
            <li>
                <a asp-page="/Admin/Orders/Index" class="menu-link @(Context.Request.Path.Value?.Contains("/Admin/Orders") == true ? "active" : "")">
                    <span class="menu-icon">📋</span>
                    <span class="menu-text">QL Đơn hàng</span>
                    <span id="admin-sidebar-badge" class="menu-badge" style="display: none;">0</span>
                </a>
            </li>

            <span class="menu-label">Xem nhanh</span>
            <li>
                <a asp-page="/Index" class="menu-link">
                    <span class="menu-icon">🌐</span>
                    <span class="menu-text">Xem Cửa hàng</span>
                </a>
            </li>
        </ul>
    </aside>

    <!-- MAIN WRAPPER -->
    <div class="admin-wrapper">
        <!-- HEADER -->
        <header class="admin-header">
            <div class="header-title">
                @ViewData["Title"]
            </div>
            <div class="header-right">
                <span class="datetime-display" id="live-datetime"></span>
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/Auth/Logout" class="btn-logout">Đăng xuất</a>
                }
            </div>
        </header>

        <!-- CONTENT BODY -->
        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <!-- SCRIPTS -->
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Live DateTime Display
            function updateDateTime() {
                const now = new Date();
                const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' };
                const formatter = new Intl.DateTimeFormat('vi-VN', options);
                const el = document.getElementById('live-datetime');
                if (el) el.textContent = formatter.format(now);
            }
            updateDateTime();
            setInterval(updateDateTime, 1000);

            // New Orders count polling & notifications
            let lastCount = -1;
            
            function checkNewOrders() {
                fetch('/Admin/Orders/Index?handler=NewOrdersCount')
                    .then(response => response.json())
                    .then(data => {
                        if (data && typeof data.count === 'number') {
                            const count = data.count;
                            
                            // Update badge count
                            const badge = document.getElementById('admin-sidebar-badge');
                            if (badge) {
                                if (count > 0) {
                                    badge.textContent = count;
                                    badge.style.display = 'inline-block';
                                } else {
                                    badge.style.display = 'none';
                                }
                            }

                            // Check for new order notification
                            if (lastCount !== -1 && count > lastCount) {
                                showAdminNotification("Có đơn hàng mới vừa được đặt!");
                            }
                            lastCount = count;
                        }
                    })
                    .catch(err => console.error("Error polling new orders:", err));
            }

            function showAdminNotification(message) {
                const toast = document.createElement('div');
                toast.style.position = 'fixed';
                toast.style.bottom = '24px';
                toast.style.right = '24px';
                toast.style.background = '#e60380';
                toast.style.color = '#fff';
                toast.style.padding = '16px 24px';
                toast.style.borderRadius = '12px';
                toast.style.boxShadow = '0 10px 25px rgba(230,3,128,0.3)';
                toast.style.fontWeight = '600';
                toast.style.zIndex = '9999';
                toast.style.display = 'flex';
                toast.style.alignItems = 'center';
                toast.style.gap = '10px';
                toast.style.transition = 'all 0.3s ease';
                
                toast.innerHTML = `<span>🔔</span> <span>${message}</span>`;
                document.body.appendChild(toast);

                // Play notification bip sound
                try {
                    const context = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = context.createOscillator();
                    const gain = context.createGain();
                    osc.connect(gain);
                    gain.connect(context.destination);
                    osc.frequency.value = 523.25;
                    gain.gain.setValueAtTime(0.1, context.currentTime);
                    osc.start();
                    osc.stop(context.currentTime + 0.15);
                } catch(e) {}

                setTimeout(() => {
                    toast.style.opacity = '0';
                    toast.style.transform = 'translateY(20px)';
                    setTimeout(() => toast.remove(), 300);
                }, 5000);
            }

            // Check immediately on load and then every 10 seconds
            checkNewOrders();
            setInterval(checkNewOrders, 10000);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
