<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sweet Shell Cup</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SweetShellCup.styles.css" asp-append-version="true" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Work Sans', sans-serif; background: #fff; color: #333; }

        /* ===== NAVBAR ===== */
        .ssc-navbar {
            position: sticky; top: 0; z-index: 1000;
            background: #fff;
            box-shadow: 0 2px 12px rgba(253,132,178,0.12);
            padding: 0 60px;
            height: 72px;
            display: flex; align-items: center; justify-content: space-between;
        }
        .ssc-navbar .brand {
            display: flex; align-items: center; gap: 10px;
            text-decoration: none;
        }
        .ssc-navbar .brand-logo {
            width: 44px; height: 44px;
            background: linear-gradient(135deg, #e60380, #fd84b2);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px;
        }
        .ssc-navbar .brand-name {
            font-size: 20px; font-weight: 700;
            background: linear-gradient(135deg, #e60380, #fd84b2);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .ssc-nav-links {
            display: flex; align-items: center; gap: 8px; list-style: none;
        }
        .ssc-nav-links li a {
            text-decoration: none;
            font-size: 15px; font-weight: 500;
            color: #533931;
            padding: 8px 16px; border-radius: 8px;
            transition: all 0.2s;
            position: relative;
        }
        .ssc-nav-links li a:hover,
        .ssc-nav-links li a.active {
            color: #e60380;
            background: #fff0f7;
        }
        .ssc-nav-right {
            display: flex; align-items: center; gap: 12px;
        }
        .cart-btn {
            position: relative;
            text-decoration: none;
            width: 44px; height: 44px;
            border-radius: 12px;
            background: #fff0f7;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
            color: #e60380;
            transition: all 0.2s;
        }
        .cart-btn:hover { background: #ffd6ea; }
        .cart-badge {
            position: absolute; top: -4px; right: -4px;
            background: #e60380; color: #fff;
            font-size: 10px; font-weight: 700;
            width: 18px; height: 18px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            border: 2px solid #fff;
        }

        /* ===== MAIN CONTENT ===== */
        .ssc-main { min-height: calc(100vh - 72px - 280px); }

        /* ===== FOOTER ===== */
        .ssc-footer {
            background: #533931;
            color: #fff;
            padding: 60px;
        }
        .footer-grid {
            display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px;
            max-width: 1400px; margin: 0 auto;
        }
        .footer-brand-name {
            font-size: 24px; font-weight: 700;
            background: linear-gradient(135deg, #fd84b2, #e60380);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            margin-bottom: 12px;
        }
        .footer-desc { font-size: 14px; color: #e0b8b0; line-height: 1.7; margin-bottom: 20px; }
        .footer-social { display: flex; gap: 10px; }
        .footer-social a {
            width: 36px; height: 36px; border-radius: 8px;
            background: rgba(255,255,255,0.1);
            display: flex; align-items: center; justify-content: center;
            color: #fff; text-decoration: none; font-size: 16px;
            transition: background 0.2s;
        }
        .footer-social a:hover { background: #e60380; }
        .footer-col h4 { font-size: 14px; font-weight: 600; color: #fd84b2; margin-bottom: 16px; text-transform: uppercase; letter-spacing: 1px; }
        .footer-col ul { list-style: none; }
        .footer-col ul li { margin-bottom: 10px; }
        .footer-col ul li a { color: #e0b8b0; text-decoration: none; font-size: 14px; transition: color 0.2s; }
        .footer-col ul li a:hover { color: #fd84b2; }
        .footer-bottom {
            border-top: 1px solid rgba(255,255,255,0.1);
            padding-top: 24px; margin-top: 40px;
            max-width: 1400px; margin-left: auto; margin-right: auto;
            display: flex; justify-content: space-between; align-items: center;
            font-size: 13px; color: #e0b8b0;
        }

        /* ===== SHARED UTILITIES ===== */
        .btn-pink {
            background: linear-gradient(135deg, #e60380, #fd84b2);
            color: #fff; border: none;
            padding: 12px 28px; border-radius: 10px;
            font-family: 'Work Sans', sans-serif;
            font-size: 15px; font-weight: 600;
            cursor: pointer; text-decoration: none;
            display: inline-flex; align-items: center; gap: 8px;
            transition: all 0.2s; box-shadow: 0 4px 15px rgba(230,3,128,0.3);
        }
        .btn-pink:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(230,3,128,0.4); color: #fff; }
        .btn-outline-pink {
            background: transparent;
            color: #e60380; border: 2px solid #fd84b2;
            padding: 10px 24px; border-radius: 10px;
            font-family: 'Work Sans', sans-serif;
            font-size: 14px; font-weight: 600;
            cursor: pointer; text-decoration: none;
            display: inline-flex; align-items: center; gap: 8px;
            transition: all 0.2s;
        }
        .btn-outline-pink:hover { background: #fff0f7; color: #e60380; }
        .section-label {
            font-size: 13px; font-weight: 600; letter-spacing: 2px;
            text-transform: uppercase; color: #e60380; margin-bottom: 8px;
        }
        .section-title {
            font-size: 36px; font-weight: 700; color: #533931; line-height: 1.2;
        }
        .star-filled { color: #f59e0b; }
        .star-empty { color: #d1d5db; }

        @@media (max-width: 768px) {
            .ssc-navbar { padding: 0 20px; }
            .footer-grid { grid-template-columns: 1fr 1fr; }
            .footer-bottom { flex-direction: column; gap: 8px; }
        }
    </style>
</head>
<body>
    <!-- NAVBAR -->
    <nav class="ssc-navbar">
        <a class="brand" asp-page="/Index">
            <div class="brand-logo">🍦</div>
            <span class="brand-name">Sweet Shell Cup</span>
        </a>

        <ul class="ssc-nav-links">
            <li><a asp-page="/Index" class="@(ViewData["ActivePage"]?.ToString() == "Home" ? "active" : "")">Home</a></li>
            <li><a asp-page="/OurStory/Index" class="@(ViewData["ActivePage"]?.ToString() == "OurStory" ? "active" : "")">Our Story</a></li>
            <li><a asp-page="/Shop/Index" class="@(ViewData["ActivePage"]?.ToString() == "Shop" ? "active" : "")">Shop</a></li>
            <li><a asp-page="/Feedback/Index" class="@(ViewData["ActivePage"]?.ToString() == "Feedback" ? "active" : "")">Feedback</a></li>
        </ul>

        <div class="ssc-nav-right">
            @if (User?.Identity?.IsAuthenticated == true)
            {
                if (User.IsInRole("Admin"))
                {
                    <a asp-page="/Admin/Index" style="margin-right:15px; font-weight:600; color:#e60380; text-decoration:none;">Trang quản trị</a>
                }
                else
                {
                    <a asp-page="/Customer/Orders/Index" style="margin-right:15px; font-weight:600; color:#e60380; text-decoration:none;">Đơn hàng của tôi</a>
                }
                <span style="font-weight:600; color:#533931; margin-right:15px;">Chào, @User.Identity.Name</span>
                <a asp-page="/Auth/Logout" class="btn-outline-pink" style="padding: 6px 12px; margin-right: 15px;">Đăng xuất</a>
            }
            else
            {
                <a asp-page="/Auth/Login" class="btn-pink" style="padding: 6px 12px; margin-right: 15px;">Đăng nhập</a>
            }

            <a class="cart-btn" asp-page="/Cart/Index" title="Giỏ hàng">
                🛒
                @{
                    var cartCount = ViewData["CartCount"] as int? ?? 0;
                }
                @if (cartCount > 0)
                {
                    <span class="cart-badge">@cartCount</span>
                }
            </a>
        </div>
    </nav>

    <div class="ssc-main">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="ssc-footer">
        <div class="footer-grid">
            <div>
                <div class="footer-brand-name">🍦 Sweet Shell Cup</div>
                <p class="footer-desc">Cốc ăn được độc đáo – vừa uống vừa ăn, giảm rác thải và tạo trải nghiệm mới cho người dùng.</p>
                <div class="footer-social">
                    <a href="#">f</a>
                    <a href="#">in</a>
                    <a href="#">ig</a>
                </div>
            </div>
            <div class="footer-col">
                <h4>Sản phẩm</h4>
                <ul>
                    <li><a asp-page="/Shop/Index">Tất cả sản phẩm</a></li>
                    <li><a href="#">Edible Cup</a></li>
                    <li><a href="#">Combo</a></li>
                    <li><a href="#">Gift Set</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>Công ty</h4>
                <ul>
                    <li><a asp-page="/OurStory/Index">Về chúng tôi</a></li>
                    <li><a asp-page="/Feedback/Index">Đánh giá</a></li>
                    <li><a href="#">Liên hệ</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>Hỗ trợ</h4>
                <ul>
                    <li><a href="#">Chính sách đổi trả</a></li>
                    <li><a href="#">Vận chuyển</a></li>
                    <li><a href="#">FAQ</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© 2026 Sweet Shell Cup. All rights reserved.</span>
            <span>Made with ❤️ in Vietnam</span>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>