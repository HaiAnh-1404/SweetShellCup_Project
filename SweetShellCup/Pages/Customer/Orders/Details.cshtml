@page "{id:int}"
@model SweetShellCup.Pages.Customer.Orders.DetailsModel
@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.Order.OrderId}";

    // Status translation and timeline calculations
    var currentStatus = Model.Order.Status;
    var progressWidth = "0%";
    var isStep2Active = false; // Confirmed
    var isStep3Active = false; // Packing
    var isStep4Active = false; // Shipping
    var isStep5Active = false; // Completed

    if (currentStatus == "Confirmed")
    {
        progressWidth = "25%";
        isStep2Active = true;
    }
    else if (currentStatus == "Packing")
    {
        progressWidth = "50%";
        isStep2Active = true;
        isStep3Active = true;
    }
    else if (currentStatus == "Shipping")
    {
        progressWidth = "75%";
        isStep2Active = true;
        isStep3Active = true;
        isStep4Active = true;
    }
    else if (currentStatus == "Completed")
    {
        progressWidth = "100%";
        isStep2Active = true;
        isStep3Active = true;
        isStep4Active = true;
        isStep5Active = true;
    }

    var fullAddress = Model.Order.ShippingAddress ?? "";
    var cleanAddress = fullAddress.Split("||")[0].Trim();
    var carrier = "";
    var tracking = "";
    if (fullAddress.Contains("||"))
    {
        var parts = fullAddress.Split("||");
        foreach (var part in parts)
        {
            if (part.StartsWith("Carrier:"))
            {
                carrier = part.Replace("Carrier:", "").Trim();
            }
            else if (part.StartsWith("Tracking:"))
            {
                tracking = part.Replace("Tracking:", "").Trim();
            }
        }
    }

    string receiptPath = "";
    bool hasReceipt = false;
    var extensions = new[] { ".png", ".jpg", ".jpeg" };
    foreach (var ext in extensions)
    {
        var testPath = System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", "uploads", "receipts", $"receipt_{Model.Order.OrderId}{ext}");
        if (System.IO.File.Exists(testPath))
        {
            receiptPath = $"uploads/receipts/receipt_{Model.Order.OrderId}{ext}";
            hasReceipt = true;
            break;
        }
    }

    var payment = Model.Order.Payments.FirstOrDefault();
    var isBankTransfer = payment?.PaymentMethodId == 2;
    var isUnpaid = payment?.PaymentStatus != "Paid";
}

<style>
    .timeline {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
        margin: 40px 0;
        padding: 0 40px;
    }

        .timeline::before {
            content: '';
            position: absolute;
            top: 27px;
            left: 80px;
            right: 80px;
            height: 4px;
            background: #e2e8f0;
            z-index: 1;
        }

    .timeline-progress {
        position: absolute;
        top: 27px;
        left: 80px;
        height: 4px;
        background: linear-gradient(135deg, #e60380, #fd84b2);
        z-index: 2;
        transition: width 0.4s ease;
    }

    .timeline-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 3;
        width: 100px;
    }

    .step-icon {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: #fff;
        border: 3px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: #a0aec0;
        transition: all 0.3s ease;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }

    .timeline-step.active .step-icon {
        border-color: #e60380;
        background: linear-gradient(135deg, #e60380, #fd84b2);
        color: #fff;
        box-shadow: 0 4px 15px rgba(230,3,128,0.25);
    }

    .step-label {
        margin-top: 12px;
        font-size: 13px;
        font-weight: 600;
        color: #718096;
        text-align: center;
        white-space: nowrap;
    }

    .timeline-step.active .step-label {
        color: #e60380;
        font-weight: 700;
    }

    .detail-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #ffd6ea;
        box-shadow: 0 8px 24px rgba(253, 132, 178, 0.05);
        padding: 30px;
        margin-bottom: 30px;
    }

    .card-title {
        font-size: 18px;
        font-weight: 700;
        color: #533931;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-bottom: 2px solid #fff0f7;
        padding-bottom: 12px;
    }

    .product-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px dashed #ffd6ea;
    }

        .product-row:last-child {
            border-bottom: none;
        }

    @@media(max-width: 768px) {
        .timeline {
            flex-direction: column;
            gap: 20px;
            align-items: flex-start;
            padding: 0;
        }

            .timeline::before, .timeline-progress {
                display: none;
            }

        .timeline-step {
            flex-direction: row;
            gap: 15px;
            width: 100%;
        }

        .step-label {
            margin-top: 0;
            text-align: left;
        }
    }
</style>

<div class="details-container" style="max-width: 1200px; margin: 40px auto; padding: 0 20px;">
    <!-- HEADER -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px; margin-bottom: 35px;">
        <div>
            <a asp-page="./Index" class="btn-outline-pink" style="padding: 6px 16px; font-size: 13px; margin-bottom: 15px; display: inline-flex;">
                ⬅️ Quay lại danh sách
            </a>
            <h1 class="section-title">Chi tiết đơn hàng #@Model.Order.OrderId</h1>
            <p style="color: #666; margin-top: 4px;">Đặt ngày @(Model.Order.OrderDate?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</p>
        </div>

        <div>
            @if (currentStatus == "Cancelled")
            {
                <span style="display: inline-block; padding: 8px 24px; border-radius: 30px; background: #fee2e2; color: #ef4444; font-weight: 700; font-size: 16px;">
                    ❌ ĐÃ HỦY ĐƠN HÀNG
                </span>
            }
            else
            {
                string vnStatus = "Chờ xác nhận";
                if (currentStatus == "Confirmed") vnStatus = "Đã xác nhận";
                else if (currentStatus == "Packing") vnStatus = "Đang đóng gói";
                else if (currentStatus == "Shipping") vnStatus = "Đang giao hàng";
                else if (currentStatus == "Completed") vnStatus = "Đã hoàn thành";

                <span style="display: inline-block; padding: 8px 24px; border-radius: 30px; background: #fff0f7; color: #e60380; font-weight: 700; font-size: 16px; border: 1px solid #fd84b2;">
                    ✨ Trạng thái: @vnStatus
                </span>
            }
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div style="background-color: #e6f6ee; color: #10b981; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-weight: 600;">
            @TempData["Message"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div style="background-color: #fef2f2; color: #ef4444; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-weight: 600;">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- TIMELINE PROGRESS -->
    @if (currentStatus != "Cancelled")
    {
        <div class="detail-card">
            <h2 class="card-title">🚀 Tiến trình vận chuyển</h2>
            <div class="timeline">
                <div class="timeline-progress" style="width: @progressWidth;"></div>

                <div class="timeline-step active">
                    <div class="step-icon">📋</div>
                    <div class="step-label">Chờ xác nhận</div>
                </div>

                <div class="timeline-step @(isStep2Active ? "active" : "")">
                    <div class="step-icon">✔️</div>
                    <div class="step-label">Đã xác nhận</div>
                </div>

                <div class="timeline-step @(isStep3Active ? "active" : "")">
                    <div class="step-icon">🍳</div>
                    <div class="step-label">Đang chuẩn bị</div>
                </div>

                <div class="timeline-step @(isStep4Active ? "active" : "")">
                    <div class="step-icon">🚚</div>
                    <div class="step-label">Đang giao</div>
                </div>

                <div class="timeline-step @(isStep5Active ? "active" : "")">
                    <div class="step-icon">🎁</div>
                    <div class="step-label">Hoàn thành</div>
                </div>
            </div>
        </div>
    }

    <!-- TWO COLUMN LAYOUT -->
    <div style="display: grid; grid-template-columns: 7fr 5fr; gap: 30px; margin-top: 30px; align-items: start;">
        <!-- LEFT COLUMN: ITEMS & DELIVARY -->
        <div>
            <!-- Order Items -->
            <div class="detail-card">
                <h3 class="card-title">🧁 Danh sách sản phẩm</h3>
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    @foreach (var item in Model.Order.OrderDetails)
                    {
                        <div class="product-row">
                            <div style="display: flex; align-items: center; gap: 15px;">
                                @{
                                    // Fix image URL handling
                                    var imageUrl = item.Product?.ImageUrl;
                                    var hasValidImage = !string.IsNullOrEmpty(imageUrl) && (imageUrl.StartsWith("http") || imageUrl.StartsWith("/"));
                                    if (!hasValidImage && !string.IsNullOrEmpty(imageUrl))
                                    {
                                        // If it's a relative path without leading slash, add it
                                        imageUrl = "/" + imageUrl.TrimStart('/');
                                        hasValidImage = true;
                                    }
                                }
                                @if (hasValidImage)
                                {
                                    <img src="@imageUrl" alt="@item.Product?.ProductName" style="width: 50px; height: 50px; border-radius: 8px; object-fit: cover;" onerror="this.onerror=null; this.src='/images/default-cupcake.png'; this.style.backgroundColor='#fff0f7';" />
                                }
                                else
                                {
                                    <div style="width: 50px; height: 50px; border-radius: 8px; background: #fff0f7; display: flex; align-items: center; justify-content: center; font-size: 20px;">🧁</div>
                                }
                                <div>
                                    <h4 style="color: #533931; font-weight: 600; font-size: 15px;">@item.Product?.ProductName</h4>
                                    <p style="color: #888; font-size: 13px;">Hương vị: @(item.Product?.Flavor ?? "Vanilla") | Cỡ: @(item.Product?.Size ?? "Medium")</p>
                                </div>
                            </div>
                            <div style="text-align: right;">
                                <div style="font-weight: 700; color: #e60380;">@item.UnitPrice.ToString("N0") đ</div>
                                <div style="color: #666; font-size: 13px;">Số lượng: @item.Quantity</div>
                            </div>
                        </div>
                    }
                </div>

                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 25px; padding-top: 20px; border-top: 2px solid #fff0f7;">
                    <span style="font-size: 16px; font-weight: 700; color: #533931;">Tổng tiền cần thanh toán</span>
                    <span style="font-size: 24px; font-weight: 800; color: #e60380;">@Model.Order.TotalAmount.ToString("N0") đ</span>
                </div>
            </div>

            <!-- Delivery Address -->
            <div class="detail-card">
                <h3 class="card-title">📍 Thông tin giao hàng</h3>
                <div style="display: flex; flex-direction: column; gap: 10px; font-size: 14px; color: #533931;">
                    <p><strong>Người nhận:</strong> @Model.Order.User?.FullName</p>
                    <p><strong>Số điện thoại:</strong> @Model.Order.User?.Phone</p>
                    <p><strong>Địa chỉ giao hàng:</strong> @cleanAddress</p>

                    @if (!string.IsNullOrEmpty(carrier) || !string.IsNullOrEmpty(tracking))
                    {
                        <div style="margin-top: 15px; padding: 15px; background: #fff0f7; border: 1px solid #ffd6ea; border-radius: 12px; color: #533931;">
                            <p style="margin: 0 0 8px 0; font-size: 15px;"><strong>🚚 Đơn vị vận chuyển:</strong> @carrier</p>
                            <p style="margin: 0; display: flex; align-items: center; gap: 8px; font-size: 15px;">
                                <strong>📦 Mã vận đơn:</strong>
                                <span id="trackingCode" style="font-family: monospace; font-size: 16px; font-weight: bold; color: #e60380; background: #fff; padding: 2px 8px; border-radius: 6px; border: 1px solid #ffd6ea;">@tracking</span>
                                <button onclick="copyTrackingCode()" style="background: #e60380; border: none; cursor: pointer; padding: 4px 10px; font-size: 12px; color: #fff; font-weight: 600; border-radius: 6px; transition: opacity 0.2s;" onmouseover="this.style.opacity=0.9" onmouseout="this.style.opacity=1">Sao chép</button>
                            </p>
                        </div>
                        <script>
                            function copyTrackingCode() {
                                var code = document.getElementById("trackingCode").innerText;
                                navigator.clipboard.writeText(code).then(function() {
                                    alert("Đã sao chép mã vận đơn: " + code);
                                }, function() {
                                    alert("Không thể sao chép tự động. Vui lòng tự sao chép mã.");
                                });
                            }
                        </script>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: PAYMENT -->
        <div>
            <div class="detail-card">
                <h3 class="card-title">💳 Trạng thái thanh toán</h3>

                @if (payment != null)
                {
                    <div style="margin-bottom: 20px;">
                        <p style="font-size:14px; margin-bottom: 8px;"><strong>Phương thức:</strong> @(payment.PaymentMethod?.MethodName == "COD" ? "Thanh toán khi nhận hàng (COD)" : "Chuyển khoản ngân hàng")</p>
                        <p style="font-size:14px; margin-bottom: 8px;"><strong>Mã giao dịch:</strong> <span style="font-family: monospace; font-size: 15px; font-weight: 600; color:#533931;">@payment.TransactionCode</span></p>

                        <div style="margin-top: 15px; padding: 12px; border-radius: 10px; text-align: center; font-weight: 700;
                                @(payment.PaymentStatus == "Paid" ? "background: #d1fae5; color: #10b981;" : payment.PaymentStatus == "Pending" ? "background: #fef3c7; color: #f59e0b;" : "background: #fee2e2; color: #ef4444;")">
                            @(payment.PaymentStatus == "Paid" ? "✅ ĐÃ THANH TOÁN" : payment.PaymentStatus == "Pending" ? "⏳ ĐANG CHỜ DUYỆT" : "❌ CHƯA THANH TOÁN")
                        </div>
                    </div>

                    @if (isBankTransfer && isUnpaid && currentStatus != "Cancelled")
                    {
                        <!-- Dynamic Bank Transfer QR code via VietQR -->
                        <div style="border-top: 1px dashed #ffd6ea; padding-top: 20px; text-align: center;">
                            <h4 style="font-size: 15px; font-weight: 700; color: #533931; margin-bottom: 12px;">🏦 Quét mã VietQR chuyển khoản</h4>

                            @{
                                // Format fields for VietQR link
                                var amount = (int)Model.Order.TotalAmount;
                                var accountNo = "19039988776655";
                                var accountName = "SWEET SHELL CUP";
                                var addInfo = $"SSC{Model.Order.OrderId}";
                                var qrUrl = $"https://img.vietqr.io/image/970407-{accountNo}-compact2.jpg?amount={amount}&addInfo={addInfo}&accountName={accountName}";
                            }

                            <div style="background: #fff; display: inline-block; padding: 10px; border-radius: 12px; border: 1px solid #ffd6ea; margin-bottom: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.05);">
                                <img src="@qrUrl" alt="Mã QR Chuyển khoản" style="width: 220px; height: 220px; object-fit: contain; display: block;" />
                            </div>

                            <div style="text-align: left; font-size: 13px; color: #533931; background: #fff0f7; padding: 15px; border-radius: 10px; border: 1px solid #ffd6ea; line-height: 1.6; margin-bottom: 20px;">
                                <p style="margin: 4px 0;"><strong>Ngân hàng:</strong> Techcombank (TCB)</p>
                                <p style="margin: 4px 0;"><strong>Số tài khoản:</strong> <span style="font-weight: 700;">@accountNo</span></p>
                                <p style="margin: 4px 0;"><strong>Chủ tài khoản:</strong> <span style="font-weight: 700;">@accountName</span></p>
                                <p style="margin: 4px 0;"><strong>Số tiền:</strong> <span style="font-weight: 700; color: #e60380;">@Model.Order.TotalAmount.ToString("N0") đ</span></p>
                                <p style="margin: 4px 0;"><strong>Nội dung ck:</strong> <span style="font-weight: 700; color: #e60380; font-family: monospace;">@addInfo</span></p>
                            </div>

                            <!-- Upload Receipt Section -->
                            <div style="border-top: 1px solid #ffd6ea; padding-top: 20px; text-align: left;">
                                <h4 style="font-size: 14px; font-weight: 700; color: #533931; margin-bottom: 12px;">📤 Tải lên biên lai thanh toán</h4>

                                @if (hasReceipt)
                                {
                                    var receiptUrl = $"/{receiptPath}";
                                    <div style="background: #fff8fb; border: 1px solid #ffd6ea; border-radius: 8px; padding: 12px; text-align: center; margin-bottom: 15px;">
                                        <p style="font-size: 13px; color: #e60380; font-weight: 600; margin-bottom: 10px;">Biên lai đã tải lên trước đó:</p>
                                        <a href="@receiptUrl" target="_blank">
                                            <img src="@receiptUrl" alt="Biên lai của bạn" style="max-height: 150px; max-width: 100%; border-radius: 6px; border: 1px solid #ffd6ea; object-fit: contain;" onerror="this.onerror=null; this.style.display='none'; this.nextSibling.style.display='block';" />
                                            <span style="display: none; font-size: 12px; color: #888;">Không thể hiển thị ảnh. <u>Nhấp để xem</u></span>
                                        </a>
                                    </div>
                                }

                                <form method="post" asp-page-handler="UploadReceipt" asp-route-id="@Model.Order.OrderId" enctype="multipart/form-data">
                                    <div style="margin-bottom: 12px;">
                                        <input type="file" name="ReceiptFile" accept="image/png, image/jpeg, image/jpg" style="font-family: inherit; font-size: 13px; width: 100%;" required />
                                    </div>
                                    <button type="submit" class="btn-pink" style="width: 100%; justify-content: center; font-size: 13px; padding: 10px;">
                                        @(hasReceipt ? "Thay đổi biên lai khác" : "Gửi biên lai thanh toán")
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div style="padding: 12px; border-radius: 10px; text-align: center; font-weight: 700; background: #fee2e2; color: #ef4444;">
                        Không có thông tin thanh toán cho đơn hàng này.
                    </div>
                }
            </div>
        </div>
    </div>
</div>