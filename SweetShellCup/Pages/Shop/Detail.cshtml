@page
@model SweetShellCup.Pages.Shop.DetailModel
@{
    ViewData["Title"] = Model.Product?.ProductName;
}

<style>
    .detail-page { max-width: 1200px; margin: 0 auto; padding: 40px 60px; }
    .breadcrumb { display: flex; gap: 8px; align-items: center; margin-bottom: 32px; font-size: 14px; color: #888; }
    .breadcrumb a { color: #e60380; text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }

    .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; margin-bottom: 60px; }

    .product-gallery {
        background: linear-gradient(135deg, #fff0f7, #ffd6ea);
        border-radius: 24px; min-height: 400px;
        display: flex; align-items: center; justify-content: center;
        font-size: 160px; position: relative; overflow: hidden;
    }
    .product-gallery img { width: 100%; height: 600px; object-fit: cover; border-radius: 24px; }

    .product-detail-info h1 { font-size: 32px; font-weight: 800; color: #533931; margin-bottom: 8px; }
    .detail-category { font-size: 13px; color: #e60380; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px; }

    .rating-row { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
    .stars { font-size: 20px; }
    .rating-count { color: #888; font-size: 14px; }

    .price-box {
        background: linear-gradient(135deg, #fff0f7, #fff5fb);
        border-radius: 16px; padding: 24px; margin-bottom: 24px;
        border: 2px solid #fdd6ea;
    }
    .price-main { font-size: 40px; font-weight: 800; color: #e60380; }
    .stock-info { font-size: 14px; margin-top: 8px; }
    .stock-ok { color: #10b981; font-weight: 600; }
    .stock-low { color: #f59e0b; font-weight: 600; }

    .detail-meta { margin-bottom: 24px; }
    .detail-meta table { width: 100%; border-collapse: collapse; }
    .detail-meta td { padding: 8px 12px; font-size: 14px; border-bottom: 1px solid #f5e6ed; }
    .detail-meta td:first-child { color: #888; font-weight: 600; width: 120px; }
    .detail-meta td:last-child { color: #533931; font-weight: 500; }

    .qty-row { display: flex; align-items: center; gap: 12px; margin-bottom: 20px; }
    .qty-input {
        width: 80px; padding: 10px; text-align: center;
        border: 2px solid #f5e6ed; border-radius: 10px;
        font-family: 'Work Sans', sans-serif; font-size: 16px; font-weight: 600;
        outline: none;
    }
    .qty-input:focus { border-color: #fd84b2; }

    /* REVIEWS */
    .reviews-section { border-top: 2px solid #f5e6ed; padding-top: 48px; }
    .reviews-section h2 { font-size: 28px; font-weight: 700; color: #533931; margin-bottom: 32px; }
    .reviews-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 40px; }
    .review-card {
        background: #fff; border-radius: 16px; padding: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.06); border: 1px solid #f5e6ed;
    }
    .review-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
    .reviewer-name { font-weight: 700; color: #533931; }
    .review-date { font-size: 12px; color: #bbb; }
    .review-stars { font-size: 16px; margin-bottom: 8px; }
    .review-comment { font-size: 14px; color: #666; line-height: 1.6; }

    /* WRITE REVIEW */
    .write-review {
        background: linear-gradient(135deg, #fff0f7, #fff5fb);
        border-radius: 20px; padding: 32px; border: 2px solid #fdd6ea;
    }
    .write-review h3 { font-size: 20px; font-weight: 700; color: #533931; margin-bottom: 20px; }
    .form-group { margin-bottom: 16px; }
    .form-label { display: block; font-size: 13px; font-weight: 600; color: #533931; margin-bottom: 6px; }
    .form-textarea {
        width: 100%; padding: 12px 16px; border: 2px solid #f5e6ed;
        border-radius: 10px; font-family: 'Work Sans', sans-serif; font-size: 14px;
        resize: vertical; min-height: 100px; outline: none;
        transition: border 0.2s;
    }
    .form-textarea:focus { border-color: #fd84b2; }
    .star-select { display: flex; flex-direction: row-reverse; justify-content: flex-end; gap: 8px; }
    .star-select input[type="radio"] { display: none; }
    .star-select label {
        font-size: 28px; cursor: pointer;
        filter: grayscale(100%); transition: filter 0.1s;
    }
    .star-select input[type="radio"]:checked ~ label,
    .star-select label:hover,
    .star-select label:hover ~ label { filter: none; }


    .toast-msg {
        position: fixed; top: 88px; right: 24px;
        background: #10b981; color: #fff;
        padding: 12px 24px; border-radius: 12px; font-weight: 600;
        box-shadow: 0 4px 20px rgba(16,185,129,0.3);
        z-index: 9999; animation: slideIn 0.3s ease;
    }
    @@keyframes slideIn { from { transform: translateX(100px); opacity:0; } to { transform: translateX(0); opacity:1; } }

    @@media (max-width: 900px) {
        .detail-page { padding: 20px; }
        .detail-grid { grid-template-columns: 1fr; gap: 30px; }
        .reviews-grid { grid-template-columns: 1fr; }
    }
</style>

@if (TempData["Message"] != null) { <div class="toast-msg">🛒 @TempData["Message"]</div> }
@if (TempData["ReviewMessage"] != null) { <div class="toast-msg" style="background:#e60380;">⭐ @TempData["ReviewMessage"]</div> }

<div class="detail-page">
    <!-- Breadcrumb -->
    <div class="breadcrumb">
        <a asp-page="/Index">Home</a> ›
        <a asp-page="/Shop/Index">Shop</a> ›
        <span>@Model.Product?.ProductName</span>
    </div>

    @if (Model.Product == null)
    {
        <p>Sản phẩm không tồn tại.</p>
    }
    else
    {
        <div class="detail-grid">
            <!-- Image -->
            <div class="product-gallery">
                @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                {
                    <img src="/images/products/@Model.Product.ImageUrl" alt="@Model.Product.ProductName"
                         onerror="this.style.display='none';this.parentElement.innerHTML='🍦';" />
                }
                else
                {
                    <span>🍦</span>
                }
            </div>

            <!-- Info -->
            <div class="product-detail-info">
                <div class="detail-category">@Model.Product.Category?.CategoryName</div>
                <h1>@Model.Product.ProductName</h1>

                <div class="rating-row">
                    <div class="stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span>@(i <= (int)Model.AverageRating ? "⭐" : "☆")</span>
                        }
                    </div>
                    <span class="rating-count">@Model.AverageRating.ToString("F1") / 5 (@Model.Reviews.Count đánh giá)</span>
                </div>

                <div class="price-box">
                    <div class="price-main">@Model.Product.Price.ToString("N0") đ</div>
                    <div class="stock-info">
                        @if (Model.Product.Stock < 10)
                        {
                            <span class="stock-low">⚠ Còn @Model.Product.Stock sản phẩm</span>
                        }
                        else
                        {
                            <span class="stock-ok">✓ Còn hàng (@Model.Product.Stock sản phẩm)</span>
                        }
                    </div>
                </div>

                <div class="detail-meta">
                    <table>
                        @if (!string.IsNullOrEmpty(Model.Product.Flavor))
                        {
                            <tr><td>Hương vị</td><td>@Model.Product.Flavor</td></tr>
                        }
                        @if (!string.IsNullOrEmpty(Model.Product.Size))
                        {
                            <tr><td>Kích thước</td><td>@Model.Product.Size</td></tr>
                        }
                        <tr><td>Danh mục</td><td>@Model.Product.Category?.CategoryName</td></tr>
                    </table>
                </div>

                <div style="margin-top: 30px; border-top: 1px solid #f5e6ed; padding-top: 24px; margin-bottom: 24px;">
                    <h3 style="font-size: 16px; font-weight: 700; color: #533931; margin-bottom: 12px;">Mô tả sản phẩm</h3>
                    <p style="color:#666; font-size:14px; line-height:1.7; margin-bottom:16px; white-space: pre-line;">
                        @if (!string.IsNullOrEmpty(Model.Product.Description))
                        {
                            @Model.Product.Description
                        }
                        else
                        {
                            <span>Sản phẩm cốc ăn được độc đáo và cao cấp từ Sweet Shell Cup. Được nướng chín vàng giòn rụm với hương vị thơm ngon đặc trưng, cốc vừa là vật chứa đồ uống lý tưởng vừa là món ăn kèm vô cùng thú vị. Thích hợp sử dụng với cà phê, sữa nóng hoặc các loại trà ngọt.</span>
                        }
                    </p>
                    
                    <div style="background: #fff0f7; border-radius: 12px; padding: 16px; border: 1px dashed #fd84b2; display: grid; grid-template-columns: 1fr; gap: 12px;">
                        <div style="font-size: 13px; color: #533931; font-weight: 600;">
                            ✨ Nguyên liệu & Thành phần:
                            <span style="font-weight: normal; color: #666; margin-left: 4px;">
                                @if (!string.IsNullOrEmpty(Model.Product.Ingredients))
                                {
                                    <span>@Model.Product.Ingredients</span>
                                }
                                else if (!string.IsNullOrEmpty(Model.Product.Flavor))
                                {
                                    <span>Bột @Model.Product.Flavor, 85% Bột mì, Đường tinh luyện, Dầu nành, Bơ thực vật, Bột quế, Nước </span>
                                }
                                else
                                {
                                    <span>85% Bột mì, Đường tinh luyện, Dầu nành, Bơ thực vật, Tinh than tre, Nước.</span>
                                }
                            </span>
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; border-top: 1px dashed #fdd6ea; padding-top: 10px;">
                            <div style="font-size: 13px; color: #533931; font-weight: 600;">
                                🔥 Đặc tính: <span style="font-weight: normal; color: #666;">Vỏ bánh giòn rụm, giữ nước tốt (tới 20 - 30 phút)</span>
                            </div>
                            <div style="font-size: 13px; color: #533931; font-weight: 600;">
                                🍃 An toàn: <span style="font-weight: normal; color: #666;">100% tự nhiên, không chất bảo quản</span>
                            </div>
                        </div>
                    </div>
                </div>

                <form method="post" asp-page-handler="AddToCart">
                    <input type="hidden" name="id" value="@Model.Product.ProductId" />
                    <div class="qty-row">
                        <label style="font-size:14px;font-weight:600;color:#533931;">Số lượng:</label>
                        <input class="qty-input" type="number" name="quantity" value="1" min="1" max="@Model.Product.Stock" />
                    </div>
                    <button class="btn-pink" type="submit" style="width:100%;">🛒 Thêm vào giỏ hàng</button>
                </form>

                <a asp-page="/Cart/Index" class="btn-outline-pink" style="width:100%;margin-top:12px;justify-content:center;">Xem giỏ hàng →</a>
            </div>
        </div>

        <!-- REVIEWS -->
        <div class="reviews-section">
            <h2>⭐ Đánh giá (@Model.Reviews.Count)</h2>

            @if (Model.Reviews.Any())
            {
                <div class="reviews-grid">
                    @foreach (var review in Model.Reviews)
                    {
                        <div class="review-card">
                            <div class="review-header">
                                <span class="reviewer-name">@review.User?.FullName</span>
                                <span class="review-date">@review.CreatedAt?.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="review-stars">
                                @for (int i = 1; i <= 5; i++) { <span>@(i <= review.Rating ? "⭐" : "☆")</span> }
                            </div>
                            <div class="review-comment">@review.Comment</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="color:#888; margin-bottom:32px;">Chưa có đánh giá nào. Hãy là người đầu tiên!</p>
            }

            <!-- Write Review -->
            <div class="write-review">
                <h3>✍️ Viết đánh giá</h3>
                <form method="post" asp-page-handler="SubmitReview">
                    <input type="hidden" name="id" value="@Model.Product.ProductId" />
                    <div class="form-group">
                        <label class="form-label">Đánh giá sao:</label>
                        <div class="star-select">
                            <input type="radio" name="Rating" id="s5" value="5" checked />
                            <label for="s5">⭐</label>
                            <input type="radio" name="Rating" id="s4" value="4" />
                            <label for="s4">⭐</label>
                            <input type="radio" name="Rating" id="s3" value="3" />
                            <label for="s3">⭐</label>
                            <input type="radio" name="Rating" id="s2" value="2" />
                            <label for="s2">⭐</label>
                            <input type="radio" name="Rating" id="s1" value="1" />
                            <label for="s1">⭐</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="comment">Nhận xét:</label>
                        <textarea class="form-textarea" id="comment" name="Comment" placeholder="Chia sẻ trải nghiệm của bạn về sản phẩm này..."></textarea>
                    </div>
                    <button class="btn-pink" type="submit">Gửi đánh giá →</button>
                </form>
            </div>
        </div>
    }
</div>
