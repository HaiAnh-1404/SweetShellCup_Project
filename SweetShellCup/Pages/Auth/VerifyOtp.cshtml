@page
@model SweetShellCup.Pages.Auth.VerifyOtpModel
@{
    ViewData["Title"] = "Xác thực OTP";
}

<style>
    .auth-container { max-width: 480px; margin: 60px auto; padding: 40px; background: #fff0f7; border-radius: 24px; border: 2px solid #fdd6ea; box-shadow: 0 4px 20px rgba(0,0,0,0.05); }
    .auth-container h1 { font-size: 28px; font-weight: 800; color: #533931; text-align: center; margin-bottom: 12px; }
    .auth-container p { text-align: center; color: #666; font-size: 14px; margin-bottom: 24px; line-height: 1.5; }
    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; font-size: 14px; font-weight: 600; color: #533931; margin-bottom: 8px; }
    .form-control { width: 100%; padding: 12px 16px; border: 2px solid #f5e6ed; border-radius: 12px; font-family: 'Work Sans', sans-serif; font-size: 18px; text-align: center; letter-spacing: 4px; outline: none; transition: border-color 0.2s; }
    .form-control:focus { border-color: #fd84b2; }
    .text-danger { color: #e60380; font-size: 13px; font-weight: 600; display: block; margin-top: 5px; }
    .auth-links { text-align: center; margin-top: 24px; font-size: 14px; }
    .auth-links a { color: #e60380; font-weight: 600; text-decoration: none; }
    .auth-links a:hover { text-decoration: underline; }
</style>

<div class="auth-container">
    <h1>Xác thực OTP</h1>
    <p>Một mã OTP 6 chữ số đã được gửi tới email <br /><strong style="color: #533931;">@Model.Email</strong></p>

    @if (TempData["Message"] != null)
    {
        <div style="background-color: #fffbeb; color: #d97706; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-weight: 600; font-size: 13px; text-align: center; line-height: 1.4;">
            @TempData["Message"]
        </div>
    }

    <form method="post">
        @if (!ViewData.ModelState.IsValid)
        {
            <div style="background-color: #ffe6eb; color: #e60380; padding: 12px; border-radius: 8px; margin-bottom: 20px; font-weight: 600; font-size: 14px; text-align: center;">
                <div asp-validation-summary="All" class="text-danger" style="margin: 0;"></div>
            </div>
        }

        <div class="form-group">
            <label asp-for="OtpInput">Mã xác thực OTP</label>
            <input asp-for="OtpInput" class="form-control" type="text" maxlength="6" placeholder="******" required autocomplete="off" />
            <span asp-validation-for="OtpInput" class="text-danger"></span>
        </div>

        <button type="submit" class="btn-pink" style="width: 100%; justify-content: center; padding: 12px;">Xác nhận OTP</button>
    </form>

    <div class="auth-links">
        Không nhận được mã? <a asp-page="/Auth/ForgotPassword">Gửi lại mã</a>
    </div>
</div>
